  "meta": {
    "name": "Substance and interaction reference",
    "generated": "2026-09-19",
    "purpose": "Closed vocabulary for Normalization, plus the interaction graph that generates Ask List items. Gemini selects substance ids from this file or returns `unrecognised`.",
    "scope_note": "Curated for a 36-hour demo, not exhaustive. Covers commonly prescribed drugs plus heavy coverage of systematically under-reported substances (supplements, herbals, OTC, alcohol), which is where the product's value sits.",
    "NOT_A_CLINICAL_REFERENCE": "Assembled for a hackathon prototype. Interactions listed are textbook-level and well established, but this file has not been clinically reviewed and must never be used to make real patient decisions. Every output is phrased as a question for a clinician, never as advice to a patient.",
    "source_of_truth_boundary": "This is the source of truth for WHICH SUBSTANCES EXIST and WHAT INTERACTS. It is NOT the source of truth for what any patient takes -- that is the chart (Disclosed) and the intake transcript (Undisclosed). See docs/adr/0002.",
    "translation_note": "English informal aliases are the load-bearing ones. Spanish aliases are a starting set. Haitian Creole aliases need a native-speaker pass before demo."
  },
  "severity_levels": {
    "major": "Avoid or requires close monitoring. Surface first, largest bubble.",
    "moderate": "Clinically meaningful. Worth raising in the visit.",
    "minor": "Usually tolerable. Surface only if already flagged for another reason."
  },
  "categories": {
    "prescription": "Requires a prescription.",
    "otc": "Over the counter. Frequently not considered 'medication' by patients.",
    "supplement": "Vitamin or mineral. Very frequently unreported.",
    "herbal": "Plant or traditional remedy. The least reported category and the highest-yield one.",
    "lifestyle": "Alcohol, tobacco, cannabis, caffeine, foods with known interactions."
  },
  "screening_questions": [
    { "id": "sq_supplements", "always_ask": true, "targets": ["supplement", "herbal"], "text": "Besides what the doctor prescribed, do you take any vitamins, teas, or remedies?", "why": "Patients do not classify these as medication, so a question about 'medications' misses them entirely." },
    { "id": "sq_herbal_home", "always_ask": true, "targets": ["herbal"], "text": "Does anyone send you teas or remedies from home, or do you make any yourself?", "why": "Traditional remedies sent by family are common and almost never disclosed. This is the Marie-Ange question." },
    { "id": "sq_otc", "always_ask": true, "targets": ["otc"], "text": "Do you take anything for pain, sleep, allergies, or your stomach that you buy yourself?", "why": "NSAIDs, acetaminophen, antihistamines and sleep aids carry real interactions and are seen as harmless." },
    { "id": "sq_alcohol", "always_ask": true, "targets": ["lifestyle"], "text": "Do you drink alcohol? Roughly how often in a normal week?", "why": "Interacts with a large share of the formulary and is under-reported to clinicians specifically." },
    { "id": "sq_melatonin", "always_ask": true, "targets": ["otc", "supplement"], "text": "Do you take anything to help you sleep?", "why": "Melatonin, diphenhydramine and doxylamine are all treated as non-medication by patients." },
    { "id": "sq_borrowed", "always_ask": true, "targets": ["prescription"], "text": "Have you ever taken medication that was prescribed to someone else, like a family member?", "why": "Borrowed prescriptions never appear in any chart. Ask without judgement or the answer is always no." },
    { "id": "sq_stopped", "always_ask": true, "targets": ["prescription"], "text": "Is there anything the doctor prescribed that you stopped taking, or take less often than it says?", "why": "The inverse of undisclosed: the chart says they take it and they do not. Equally invisible." },
    { "id": "sq_cannabis", "always_ask": false, "targets": ["lifestyle"], "text": "Do you use cannabis or CBD, in any form?", "why": "Additive sedation with a long list of drugs; CBD affects hepatic metabolism." },
    { "id": "sq_grapefruit", "always_ask": false, "targets": ["lifestyle"], "text": "Do you eat grapefruit or drink grapefruit juice?", "why": "Ask only when a statin, amlodipine or tacrolimus is on the chart." }
  ],
