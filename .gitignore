# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env*
!.env.example

# Retired local sync state must not be recommitted
.context-sync-state.json
.context-sync.local.json
__pycache__/
# Project Markdown belongs in Obsidian; agent entry points and ADRs stay here.
docs/research/
*.[mM][dD]
!**/AGENTS.md
!**/CLAUDE.md
!**/agents.md
!**/claude.md
!/docs/adr/*.[mM][dD]
CLAUDE.local.md

# Neon CLI local project link
.neon
